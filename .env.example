# --- تنظیمات پایه ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# --- پایگاه داده ---
# پیش‌فرض SQLite است. برای PostgreSQL مقدار زیر را ست کنید:
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# --- ایمیل (برای ارسال اعلان درخواست مشاوره) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com
NOTIFY_EMAIL=lawyer@example.com

# --- امنیت پشت پراکسی/HTTPS ---
SECURE_SSL_REDIRECT=False
